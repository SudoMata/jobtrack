# Port the API listens on (default: 3000)
PORT=3000

# Runtime connection: Supabase transaction pooler (port 6543).
# Contains the database password: put the real value in .env only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Direct connection, read only by the Prisma CLI for migrations (prisma.config.ts).
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase CA certificate (relative to apps/api), used to verify the TLS connection.
DATABASE_SSL_CA_PATH=certs


# Supabase project URL, used to find the public keys that verify access tokens.
SUPABASE_URL=https://<project-ref>.supabase.co

# Maximum requests per minute and per client IP address (default: 120)
RATE_LIMIT_PER_MINUTE=120

# Number of reverse proxies in front of the API (default: 0).
# Behind Render it must be the exact number of hops, verified at deployment time.
TRUST_PROXY_HOPS=0