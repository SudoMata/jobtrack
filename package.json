{
  "name": "jobtrack",
  "version": "0.0.0",
  "description": "Centralize and track a candidate's job applications.",
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "private": "true",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  }
}
